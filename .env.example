# LLM used by the agent (Stagehand). Format: provider/model.
# Default provider is OpenAI; pick a current model from Stagehand's supported list.
MODEL_NAME=openai/<model>
OPENAI_API_KEY=
# Only needed if MODEL_NAME uses another provider, e.g. anthropic/...
# ANTHROPIC_API_KEY=

# Fake system URLs
SITS_URL=http://localhost:3001
BB_URL=http://localhost:3002

# Show the browser during runs (false for demos)
HEADLESS=false
