# LLM used by the agent (Stagehand). Format: provider/model.
# Default: Stagehand's recommended OpenAI model for accuracy vs cost.
MODEL_NAME=openai/gpt-5.6-sol
OPENAI_API_KEY=
# Only needed if MODEL_NAME uses another provider, e.g. anthropic/...
# ANTHROPIC_API_KEY=

# Fake system URLs
SITS_URL=http://localhost:3001
BB_URL=http://localhost:3002

# Show the browser during runs (false for demos)
HEADLESS=false

# Countdown before the browser windows open, in ms (e.g. 15000), so you can start recording.
START_DELAY_MS=0

# Second-look extraction sends a screenshot of the SITS page to the model provider.
# Set false for any pilot unless the DPO approves images (see docs/DATA_FLOW_DPIA.md).
ALLOW_SCREENSHOTS=true
